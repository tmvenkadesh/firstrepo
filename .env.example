# Database
MONGODB_URI=mongodb://localhost:27017/evaluation-tools

# JWT Configuration
JWT_SECRET=your-super-secure-jwt-secret-key-here
JWT_EXPIRE=24h

# Session Configuration
SESSION_SECRET=your-super-secure-session-secret-here

# Client URL (for redirects)
CLIENT_URL=http://localhost:3000

# OAuth2 SSO Configuration (Azure AD, Okta, etc.)
SSO_OAUTH_ENABLED=false
SSO_PROVIDER_NAME=Enterprise SSO
SSO_CLIENT_ID=your-oauth-client-id
SSO_CLIENT_SECRET=your-oauth-client-secret
SSO_AUTHORIZATION_URL=https://login.microsoftonline.com/tenant-id/oauth2/v2.0/authorize
SSO_TOKEN_URL=https://login.microsoftonline.com/tenant-id/oauth2/v2.0/token
SSO_USERINFO_URL=https://graph.microsoft.com/v1.0/me
SSO_CALLBACK_URL=http://localhost:5000/api/auth/sso/callback

# SAML SSO Configuration
SSO_SAML_ENABLED=false
SAML_PROVIDER_NAME=SAML SSO
SAML_ENTRY_POINT=https://your-saml-provider.com/sso/saml
SAML_ISSUER=your-app-identifier
SAML_CALLBACK_URL=http://localhost:5000/api/auth/saml/callback
SAML_CERT=-----BEGIN CERTIFICATE-----...-----END CERTIFICATE-----
SAML_PRIVATE_CERT=-----BEGIN PRIVATE KEY-----...-----END PRIVATE KEY-----

# Email Configuration (for notifications)
EMAIL_ENABLED=false
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Admin Configuration
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_NAME=System Admin

# Application Settings
NODE_ENV=development
PORT=5000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads/

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log